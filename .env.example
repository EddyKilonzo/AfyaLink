# AfyaLink environment template.
# Copy to `.env` in the repository root:  cp .env.example .env
# The backend reads backend/.env then ../.env. The frontend reads only the
# NEXT_PUBLIC_* keys from this root file (or frontend/.env.local).
# Never commit a real .env. Never put secrets in NEXT_PUBLIC_* variables.

# ---------------------------------------------------------------------------
# Frontend (public, embedded in the browser bundle)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Allowed browser origins (comma-separated). FRONTEND_ORIGIN is accepted as an alias.
CORS_ORIGINS=http://localhost:3000
# FRONTEND_ORIGIN=http://localhost:3000

# Number of reverse-proxy hops to trust for client IPs (rate limiting). 0 = none.
TRUST_PROXY=0
# Max JSON request body size.
BODY_LIMIT=256kb

# ---------------------------------------------------------------------------
# MySQL (8.0+ or MariaDB 10.5+). Use EITHER DATABASE_URL OR the DB_* variables.
# Leave empty to start the API without a database (/api/health still works;
# data endpoints return 503).
# ---------------------------------------------------------------------------
# DATABASE_URL=mysql://afyalink_app:change-me@127.0.0.1:3306/afyalink
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=afyalink
DB_USER=afyalink_app
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Session signing secret, at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET is accepted as an alias.
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
# Secure (HTTPS-only) cookies. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
# Per-account lockout after repeated failed sign-ins.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
