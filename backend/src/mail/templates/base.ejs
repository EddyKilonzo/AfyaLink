<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= subject %></title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
</head>
<body style="margin: 0; padding: 0; background-color: #f7f9f7; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%;">
  <!-- Preheader text -->
  <div style="display: none; max-height: 0; overflow: hidden; font-size: 1px; line-height: 1px; color: #f7f9f7;">AfyaLink - Community Health Reporting Platform</div>
  
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f7f9f7; min-width: 320px;">
    <tr>
      <td align="center" style="padding: 40px 20px;">
        <!-- Main container -->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; background-color: #ffffff; border-radius: 16px; box-shadow: 0 0 0 1px rgb(11 61 53 / 0.06), 0 1px 2px rgb(11 61 53 / 0.06), 0 4px 10px -4px rgb(11 61 53 / 0.08), 0 16px 32px -20px rgb(11 61 53 / 0.18); overflow: hidden;">
          
          <!-- Header -->
          <tr>
            <td style="background: linear-gradient(135deg, #146C5A 0%, #1D8A70 50%, #21865B 100%); padding: 40px 32px; text-align: center;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center">
                    <!-- Logo -->
                    <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: block; margin: 0 auto 16px;">
                      <rect width="56" height="56" rx="14" fill="white" opacity="0.15"/>
                      <path d="M28 10L45 22V44L28 56L11 44V22L28 10Z" stroke="white" stroke-width="2.5" fill="none"/>
                      <circle cx="28" cy="28" r="6" fill="white"/>
                    </svg>
                    <h1 style="margin: 0; color: #ffffff; font-size: 24px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2;">AfyaLink</h1>
                    <p style="margin: 8px 0 0; color: rgba(255,255,255,0.9); font-size: 14px; font-weight: 400;">Community Health Reporting</p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          
          <!-- Content -->
          <tr>
            <td style="padding: 40px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="color: #172522; font-size: 16px; line-height: 1.6;">
                    <h2 style="margin: 0 0 24px; color: #172522; font-size: 22px; font-weight: 600; letter-spacing: -0.02em;"><%= title %></h2>
                    <%- body %>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          
          <!-- Divider -->
          <tr>
            <td style="padding: 0 32px 24px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="border-top: 1px solid #e3eae6;"></td>
                </tr>
              </table>
            </td>
          </tr>
          
          <!-- Footer -->
          <tr>
            <td style="background-color: #f7f9f7; padding: 24px 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" style="color: #687873; font-size: 13px; line-height: 1.5;">
                    <p style="margin: 0 0 8px;"><strong style="color: #172522;">AfyaLink</strong> - Academic Prototype for Community Health</p>
                    <p style="margin: 0 0 12px;">This is an automated message from the AfyaLink platform. Please do not reply to this email.</p>
                    <p style="margin: 0; font-size: 12px;"><strong>Disclaimer:</strong> AfyaLink is an academic prototype. It is not connected to any national health information system. All data shown is synthetic.</p>
                  </td>
                </tr>
                <tr>
                  <td align="center" style="padding-top: 16px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td style="padding: 0 8px;">
                          <a href="<%= appUrl %>" style="color: #146C5A; text-decoration: none; font-size: 13px; font-weight: 500;">Dashboard</a>
                        </td>
                        <td style="color: #cfdad4; font-size: 12px;">|</td>
                        <td style="padding: 0 8px;">
                          <a href="<%= appUrl %>/help" style="color: #146C5A; text-decoration: none; font-size: 13px; font-weight: 500;">Help Center</a>
                        </td>
                        <td style="color: #cfdad4; font-size: 12px;">|</td>
                        <td style="padding: 0 8px;">
                          <a href="<%= appUrl %>/privacy" style="color: #146C5A; text-decoration: none; font-size: 13px; font-weight: 500;">Privacy</a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
                <tr>
                  <td align="center" style="padding-top: 16px; color: #8aa099; font-size: 11px;">
                    <p style="margin: 0;">&copy; 2025 AfyaLink. All rights reserved.</p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          
        </table>
      </td>
    </tr>
  </table>
</body>
</html>