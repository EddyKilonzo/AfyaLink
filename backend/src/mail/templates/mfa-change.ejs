<%- include('base.ejs', {
  subject: 'Two-factor authentication for AfyaLink',
  title: enabled ? 'Two-factor authentication enabled' : 'Two-factor authentication disabled',
  body: `
    <p style="margin: 0 0 20px; color: #172522;">Hi ` + safeName + `,</p>
    <p style="margin: 0 0 20px; color: #172522;">` + (enabled ? 'Two-factor authentication (2FA) has been successfully enabled on your AfyaLink account.' : 'Two-factor authentication (2FA) has been disabled on your AfyaLink account.') + `</p>
    
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0;">
      <tr>
        <td style="background: ` + (enabled ? 'linear-gradient(135deg, #eef9f3 0%, #ddf5ea 100%)' : 'linear-gradient(135deg, #fdf1df 0%, #fbe7e9 100%)') + `; border-radius: 12px; padding: 20px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td style="width: 48px;">
                <div style="width: 40px; height: 40px; border-radius: 10px; background: ` + (enabled ? '#146C5A' : '#C43D4B') + `; display: flex; align-items: center; justify-content: center;">
                  ` + (enabled ? `
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                  ` : `
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    <line x1="9" y1="16" x2="15" y2="22"/>
                    <line x1="15" y1="16" x2="9" y2="22"/>
                  </svg>
                  `) + `
                </div>
              </td>
              <td style="padding-left: 16px;">
                <p style="margin: 0 0 4px; color: ` + (enabled ? '#146C5A' : '#C43D4B') + `; font-size: 14px; font-weight: 600;">` + (enabled ? '2FA is now active' : '2FA has been turned off') + `</p>
                <p style="margin: 0; color: #687873; font-size: 13px;">` + (enabled ? 'You\'ll need your authenticator app to sign in' : 'Your account now uses password-only authentication') + `</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
    
    ` + (enabled ? `
    <p style="margin: 0 0 16px; color: #172522;">When you sign in next time, you'll need to enter a 6-digit code from your authenticator app (Google Authenticator, Authy, Microsoft Authenticator, etc.).</p>
    
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 24px;">
      <tr>
        <td style="padding: 16px; background-color: #e4eef9; border-radius: 8px; border-left: 4px solid #22609F;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td style="width: 24px; vertical-align: top;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22609F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" y1="16" x2="12" y2="12"/>
                  <line x1="12" y1="8" x2="12.01" y2="8"/>
                </svg>
              </td>
              <td style="padding-left: 12px; color: #22609F; font-size: 13px; line-height: 1.5;">
                <strong>Backup codes:</strong> Save your backup codes in a safe place. They can be used if you lose access to your authenticator app.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
    ` : `
    <p style="margin: 0 0 16px; color: #172522;">Your account now uses password-only authentication. You can re-enable 2FA anytime from your account settings.</p>
    `) + `
    
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 32px 0;">
      <tr>
        <td align="center">
          <a href="` + appUrl + `/account/security" style="display: inline-block; background: linear-gradient(135deg, #146C5A 0%, #1D8A70 100%); color: #ffffff; text-decoration: none; padding: 14px 28px; border-radius: 10px; font-size: 15px; font-weight: 600; box-shadow: 0 2px 4px rgb(20 108 90 / 0.2), 0 8px 16px -4px rgb(20 108 90 / 0.15);">Manage Security Settings</a>
        </td>
      </tr>
    </table>
  `
}) -%>