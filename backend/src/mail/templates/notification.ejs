<%- include('base.ejs', {
  subject: subject,
  title: title,
  body: `
    <p style="margin: 0 0 20px; color: #172522;">Hi ` + fullName + `,</p>
    <p style="margin: 0 0 20px; color: #172522;">` + message + `</p>
    
    ` + (actionUrl && actionLabel ? `
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 32px 0;">
      <tr>
        <td align="center">
          <a href="` + actionUrl + `" style="display: inline-block; background: linear-gradient(135deg, #146C5A 0%, #1D8A70 100%); color: #ffffff; text-decoration: none; padding: 14px 28px; border-radius: 10px; font-size: 15px; font-weight: 600; box-shadow: 0 2px 4px rgb(20 108 90 / 0.2), 0 8px 16px -4px rgb(20 108 90 / 0.15);">` + actionLabel + `</a>
        </td>
      </tr>
    </table>
    ` : '') + `
    
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 24px;">
      <tr>
        <td style="padding: 16px; background-color: #f7f9f7; border-radius: 8px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td style="color: #687873; font-size: 13px; line-height: 1.5;">
                <strong>Account security:</strong> If you didn&apos;t expect this notification, please contact your administrator immediately.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  `
}) -%>