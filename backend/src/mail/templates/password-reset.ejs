<%- include('base.ejs', {
  subject: 'Reset your AfyaLink password',
  title: 'Reset your password',
  body: `
    <p style="margin: 0 0 20px; color: #172522;">Hi ` + safeName + `,</p>
    <p style="margin: 0 0 20px; color: #172522;">We received a request to reset your AfyaLink password. If you didn&apos;t make this request, you can safely ignore this email.</p>
    
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 32px 0;">
      <tr>
        <td align="center">
          <a href="` + resetUrl + `" style="display: inline-block; background: linear-gradient(135deg, #146C5A 0%, #1D8A70 100%); color: #ffffff; text-decoration: none; padding: 14px 28px; border-radius: 10px; font-size: 15px; font-weight: 600; box-shadow: 0 2px 4px rgb(20 108 90 / 0.2), 0 8px 16px -4px rgb(20 108 90 / 0.15);">Reset Password</a>
        </td>
      </tr>
    </table>
    
    <p style="margin: 0 0 8px; color: #687873; font-size: 13px;">This link expires in <strong>1 hour</strong> for security.</p>
    <p style="margin: 0 0 24px; color: #687873; font-size: 13px;">If the button doesn&apos;t work, copy and paste this link into your browser:<br><a href="` + resetUrl + `" style="color: #146C5A; word-break: break-all;">` + resetUrl + `</a></p>
    
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 24px;">
      <tr>
        <td style="padding: 16px; background-color: #fdf1df; border-radius: 8px; border-left: 4px solid #F3B66A;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td style="width: 24px; vertical-align: top;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#85560F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" y1="16" x2="12" y2="12"/>
                  <line x1="12" y1="8" x2="12.01" y2="8"/>
                </svg>
              </td>
              <td style="padding-left: 12px; color: #85560F; font-size: 13px; line-height: 1.5;">
                <strong>Security tip:</strong> AfyaLink will never ask for your password via email. If you didn&apos;t request this reset, please contact your administrator.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  `
}) -%>