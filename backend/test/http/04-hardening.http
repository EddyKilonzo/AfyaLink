# ---------------------------------------------------------------------------
# Admin: export, audit trail, and a user for the two-factor tests
# ---------------------------------------------------------------------------

### Sign in as admin
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "email": "admin@afyalink.test", "password": "AfyaLink#Dev2026" }

?? status == 200

### Admins cannot use the CHV correction route
PATCH {{baseUrl}}/reports/{{editId}}
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "casesCount": 9 }

?? status == 403

### CSV export of Mwende's reports
GET {{baseUrl}}/reports/export?chvId={{mwendeId}}

?? status == 200
?? header content-type includes text/csv
?? header content-disposition includes attachment
?? js response.body.replace(/^﻿/, '').startsWith('id,observedAt,receivedAt,category') == true
?? js response.body.includes(editId) == true

### Text that looks like a formula is neutralised in the CSV
GET {{baseUrl}}/reports/export?chvId={{mwendeId}}&severity=CRITICAL

?? status == 200
?? js response.body.includes("\"'=SUM(1,2)\"") == true

### Export validates its filters
GET {{baseUrl}}/reports/export?from=2026-10-10T00:00:00Z&to=2026-01-01T00:00:00Z

?? status == 400

### Create an admin account for the two-factor tests
# @name mfaUser
POST {{baseUrl}}/users
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "fullName": "MFA Test Admin", "email": "{{mfaEmail}}", "role": "ADMIN", "password": "{{mfaPassword}}" }

?? status == 201
?? body user.mfaEnabled == false

### The audit trail recorded the correction (field names only, never content)
GET {{baseUrl}}/audit-logs?action=report.update&targetId={{editId}}

?? status == 200
?? body total == 1
?? js response.parsedBody.items[0].actorId == {{mwendeId}}
?? js response.parsedBody.items[0].details.fields.includes('casesCount') == true
?? js JSON.stringify(response.parsedBody.items[0]).includes('Synthetic note') == false

### ...the export, with its filters
GET {{baseUrl}}/audit-logs?action=report.export&actorId={{adminId}}

?? status == 200
?? js response.parsedBody.total >= 2
?? js response.parsedBody.items.some((i) => i.details.chvId === mwendeId) == true

### ...sign-out everywhere and user creation
GET {{baseUrl}}/audit-logs?targetId={{mfaUser.user.id}}

?? status == 200
?? js response.parsedBody.items.some((i) => i.action === 'user.create' && i.actorId === adminId) == true

###
GET {{baseUrl}}/audit-logs?action=auth.logout_all&actorId={{mwendeId}}

?? status == 200
?? js response.parsedBody.total >= 1
?? js response.parsedBody.items[0].requestId.length > 0

### Audit filters are validated
GET {{baseUrl}}/audit-logs?action=drop.tables

?? status == 400

### There is no way to change or delete audit entries
DELETE {{baseUrl}}/audit-logs
X-CSRF-Token: {{csrfToken}}

?? status == 404

###
POST {{baseUrl}}/auth/logout
X-CSRF-Token: {{csrfToken}}

?? status == 204

# ---------------------------------------------------------------------------
# Two-factor sign-in (TOTP)
# ---------------------------------------------------------------------------

### The new admin signs in with a password only
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "email": "{{mfaEmail}}", "password": "{{mfaPassword}}" }

?? status == 200

### Setup requires the current password
POST {{baseUrl}}/auth/mfa/setup
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "password": "WrongPassword1" }

?? status == 400

### Setup returns a secret and an otpauth URL for the authenticator app
# @name mfaSetup
POST {{baseUrl}}/auth/mfa/setup
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "password": "{{mfaPassword}}" }

?? status == 200
?? js /^[A-Z2-7]{32}$/.test(response.parsedBody.secret) == true
?? js response.parsedBody.otpauthUrl.startsWith('otpauth://totp/AfyaLink:') == true

### Enabling with a wrong code fails
{{
  exports.wrongCode = String((Number(totpAt(mfaSetup.secret, nowStep())) + 500000) % 1000000).padStart(6, '0');
}}
POST {{baseUrl}}/auth/mfa/enable
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "code": "{{wrongCode}}" }

?? status == 400

### Enable with the current code
{{
  exports.enableStep = nowStep();
  exports.enableCode = totpAt(mfaSetup.secret, exports.enableStep);
}}
POST {{baseUrl}}/auth/mfa/enable
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "code": "{{enableCode}}" }

?? status == 204

### Setting up again while enabled is a conflict
POST {{baseUrl}}/auth/mfa/setup
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "password": "{{mfaPassword}}" }

?? status == 409

### The profile shows two-factor is on
GET {{baseUrl}}/auth/me

?? status == 200
?? body user.mfaEnabled == true

###
POST {{baseUrl}}/auth/logout
X-CSRF-Token: {{csrfToken}}

?? status == 204

### Sign-in now asks for a code
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "email": "{{mfaEmail}}", "password": "{{mfaPassword}}" }

?? status == 401
?? body message == One-time code required.

### A code cannot be used twice (the enable code is replayed)
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "email": "{{mfaEmail}}", "password": "{{mfaPassword}}", "otp": "{{enableCode}}" }

?? status == 401
?? body message == Invalid one-time code.

### A wrong password is still rejected generically, with or without a code
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "email": "{{mfaEmail}}", "password": "WrongPassword1", "otp": "123456" }

?? status == 401
?? body message == Invalid email or password.

### Sign in with the next code
{{
  exports.loginCode = totpAt(mfaSetup.secret, enableStep + 1);
}}
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "email": "{{mfaEmail}}", "password": "{{mfaPassword}}", "otp": "{{loginCode}}" }

?? status == 200
?? body user.mfaEnabled == true

### Disabling needs a valid code
POST {{baseUrl}}/auth/mfa/disable
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "password": "{{mfaPassword}}", "code": "{{wrongCode}}" }

?? status == 400

###
POST {{baseUrl}}/auth/logout
X-CSRF-Token: {{csrfToken}}

?? status == 204

### Lost device: the seed admin resets the user's two-factor
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "email": "admin@afyalink.test", "password": "AfyaLink#Dev2026" }

?? status == 200

###
POST {{baseUrl}}/users/{{mfaUser.user.id}}/reset-mfa
X-CSRF-Token: {{csrfToken}}

?? status == 204

###
GET {{baseUrl}}/audit-logs?action=user.mfa_reset&targetId={{mfaUser.user.id}}

?? status == 200
?? body total == 1

###
POST {{baseUrl}}/auth/logout
X-CSRF-Token: {{csrfToken}}

?? status == 204

### After the reset, a password is enough again
POST {{baseUrl}}/auth/login
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "email": "{{mfaEmail}}", "password": "{{mfaPassword}}" }

?? status == 200
?? body user.mfaEnabled == false

### Enrol again, then turn it off self-service
# @name mfaSetup2
POST {{baseUrl}}/auth/mfa/setup
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "password": "{{mfaPassword}}" }

?? status == 200
?? js response.parsedBody.secret !== mfaSetup.secret == true

###
{{
  exports.enableStep2 = nowStep();
}}
POST {{baseUrl}}/auth/mfa/enable
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "code": "{{ totpAt(mfaSetup2.secret, enableStep2) }}" }

?? status == 204

### Disable with the password and the next code
POST {{baseUrl}}/auth/mfa/disable
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{ "password": "{{mfaPassword}}", "code": "{{ totpAt(mfaSetup2.secret, enableStep2 + 1) }}" }

?? status == 204

###
GET {{baseUrl}}/auth/me

?? status == 200
?? body user.mfaEnabled == false

###
POST {{baseUrl}}/auth/logout
X-CSRF-Token: {{csrfToken}}

?? status == 204
