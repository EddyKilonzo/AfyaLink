{"name": "AfyaLink", "short_name": "AfyaLink", "description": "Community health reporting that works offline. Volunteers record reports on a phone; they sync to administrators when the connection returns.", "lang": "en", "dir": "ltr", "start_url": "/", "scope": "/", "display": "standalone", "orientation": "portrait", "background_color": "#f7f9f7", "theme_color": "#0b3d35", "categories": ["health", "productivity", "medical"], "icons": [{"src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable"}, {"src": "/icon-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable"}, {"src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"}, {"src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}, {"src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}], "screenshots": [{"src": "/icon.svg", "sizes": "any", "type": "image/svg+xml"}], "shortcuts": [{"name": "New report", "shortcuts": ["new"], "url": "/reports/new", "description": "Record a new health report."}, {"name": "Sync", "shortcuts": ["sync"], "url": "/sync", "description": "See what is waiting to sync."}], "prefer_related": false, "launch_handler": {"client_mode": ["navigate"]}}